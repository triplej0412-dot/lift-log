# Public web client configuration. Copy to .env.local for local development.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional in production. A blank value uses the Vite proxy during development
# and the existing LiftLog Render API in a production build.
VITE_API_BASE_URL=

# Server-only variables belong in server/.env locally or Render's environment.
# Never prefix these with VITE_ and never put real values in this file.
GEMINI_API_KEY=
# Optional: defaults to the fast, verified gemini-3.5-flash-lite model.
GEMINI_MODEL=
WORKOUTX_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
